{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "dist",
  "functions": {
    "api/render.js": { "includeFiles": "dist-ssr/**", "maxDuration": 30 },
    "api/sitemap.js": { "maxDuration": 30 }
  },
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/:path*",
      "destination": "/api/render?path=/:path*"
    }
  ]
}
